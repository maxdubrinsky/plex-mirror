package views

import (
	"fmt"

	"github.com/maxdubrinsky/plex-mirror/internal/service"
)

// SettingsPage is the full settings page (glb-gdl.13): edit sources + storage +
// download tunables from the portal instead of environment variables. Saving
// applies live (no restart) — the form posts to itself and swaps in the updated
// fragment with a result banner.
templ SettingsPage(meta PageMeta, vm SettingsVM) {
	@Layout(meta) {
		<h1>Settings</h1>
		<p class="muted small">
			Configure sources and storage here instead of editing environment variables.
			Changes apply live — no restart. Environment variables seed the initial values;
			once you save, the stored settings take over.
		</p>
		@SettingsForm(vm)
		@SourceHealthPanel(vm.Health)
	}
}

// SettingsForm is the form fragment, re-rendered on save with a banner. id is
// the hx-swap target so a save replaces it in place.
templ SettingsForm(vm SettingsVM) {
	<form id="settings-form" class="settings" hx-post="/settings" hx-target="#settings-form" hx-swap="outerHTML">
		@settingsBanner(vm)
		if !vm.Config.SecretKeySet {
			<div class="notice notice-warn">
				<b>PLEXMIRROR_SECRET_KEY is not set.</b> Source tokens are stored
				unencrypted in the local database. Set that environment variable
				(and restart once) to encrypt secrets at rest.
			</div>
		}
		<fieldset>
			<legend>Plex</legend>
			@textField("Server URL", "plex_url", vm.Config.PlexURL, "https://… — leave blank to auto-discover from plex.tv")
			@textField("Server name", "plex_server", vm.Config.PlexServer, "for plex.tv discovery when the URL is blank")
			@textField("Client ID", "plex_client_id", vm.Config.PlexClientID, "X-Plex-Client-Identifier (optional)")
			@secretField("Token", "plex_token", vm.Config.PlexTokenSet, vm.Config.PlexTokenUnreadable, "per-resource access token for the shared server")
		</fieldset>
		<fieldset>
			<legend>Jellyfin</legend>
			@textField("Server URL", "jellyfin_url", vm.Config.JellyfinURL, "https://…")
			@textField("User", "jellyfin_user", vm.Config.JellyfinUser, "user id or username (optional)")
			@secretField("Token / API key", "jellyfin_token", vm.Config.JellyfinTokenSet, vm.Config.JellyfinTokenUnreadable, "")
		</fieldset>
		<fieldset>
			<legend>Library layout</legend>
			<p class="small muted">
				Subfolder names created under the media root for each kind, so the
				layout matches your Jellyfin libraries. A single folder name each — no
				slashes. Changing these affects only newly downloaded items; files
				already mirrored stay where they are.
			</p>
			@textField("Movies folder", "movies_dir", vm.Config.MoviesDir, "default: movies")
			@textField("Shows folder", "shows_dir", vm.Config.ShowsDir, "default: shows — set to \"tv\" to match that Jellyfin layout")
			@textField("Other folder", "other_dir", vm.Config.OtherDir, "default: other")
		</fieldset>
		<fieldset>
			<legend>Storage</legend>
			<label class="field">
				<span class="field-label">Media root <span class="badge badge-muted">env-only</span></span>
				<input type="text" value={ vm.Config.MediaRoot } disabled/>
			</label>
			@textField("Hard cap", "storage_hard_cap", vm.Config.StorageHardCap, "e.g. 500G — blank/0 = uncapped")
			@textField("Soft cap", "storage_soft_cap", vm.Config.StorageSoftCap, "eviction target; must be ≤ hard cap")
		</fieldset>
		<fieldset>
			<legend>Downloads</legend>
			@textField("Concurrency", "download_concurrency", vm.Config.DownloadConcurrency, "simultaneous downloads, 1–32")
			@textField("Poll interval", "download_poll_every", vm.Config.DownloadPollEvery, "e.g. 10s — how often to scan the queue")
			@textField("Copy buffer", "download_buffer", vm.Config.DownloadBuffer, "e.g. 1M — per-stream copy buffer")
		</fieldset>
		<fieldset>
			<legend>Health &amp; reconnect</legend>
			@textField("Health check interval", "health_check_every", vm.Config.HealthCheckEvery, "e.g. 30s — how often to probe sources and auto-reconnect Plex; 0 disables")
		</fieldset>
		<div class="actions">
			<button type="submit" class="btn btn-primary">Save &amp; apply</button>
			<span class="htmx-indicator small muted">applying…</span>
		</div>
	</form>
}

// SourceHealthPanel is the source-connectivity diagnostics block under the form.
// It self-polls every 5s (so a recovering source / ticking retry countdown stays
// live without a refresh) and is the swap target for each card's "Reconnect now"
// button. Exported because the /settings/health and /settings/reconnect handlers
// render it standalone.
templ SourceHealthPanel(health []service.SourceHealthView) {
	<section id="source-health" class="settings-health" hx-get="/settings/health" hx-trigger="every 5s" hx-swap="outerHTML">
		<h2>Source health</h2>
		<p class="muted small">
			Connectivity for each source. Plex is auto-reconnected when it drops (see the
			health check interval above); use Reconnect now to retry immediately.
		</p>
		if len(health) == 0 {
			<p class="muted small">No sources configured.</p>
		} else {
			for _, h := range health {
				@sourceHealthCard(h)
			}
		}
	</section>
}

templ sourceHealthCard(h service.SourceHealthView) {
	<div class="health-card">
		<div class="row spread">
			<span class="row">
				<b>{ h.Name }</b>
				<span class={ healthStatusClass(h.Status) }>{ h.Status }</span>
				if h.Relay {
					<span class="badge badge-queued" title="Routed through Plex's bandwidth-throttled relay connection">relay</span>
				}
			</span>
			<form hx-post={ reconnectURL() } hx-target="#source-health" hx-swap="outerHTML">
				<input type="hidden" name="source" value={ h.Name }/>
				<button type="submit" class="btn small">Reconnect now</button>
				<span class="htmx-indicator small muted">reconnecting…</span>
			</form>
		</div>
		if h.LastError != "" && h.Status != "ok" {
			<div class="small notice notice-err health-err">{ h.LastError }</div>
		}
		<dl class="health-meta small">
			if h.ChosenURL != "" {
				<div><dt>Connection</dt><dd class="mono">{ h.ChosenURL }</dd></div>
			}
			<div><dt>Last success</dt><dd>{ healthAgo(h.LastSuccess) }</dd></div>
			<div><dt>Last check</dt><dd>{ healthAgo(h.LastCheck) }</dd></div>
			if h.ConsecutiveFailures > 0 {
				<div><dt>Failures</dt><dd>{ fmt.Sprintf("%d", h.ConsecutiveFailures) }</dd></div>
			}
			if !h.NextRetryAt.IsZero() && h.Status == "down" {
				<div><dt>Next retry</dt><dd>{ healthUntil(h.NextRetryAt) }</dd></div>
			}
		</dl>
		if len(h.Candidates) > 0 {
			<details class="health-cands">
				<summary class="small muted">Candidate connections ({ fmt.Sprintf("%d", len(h.Candidates)) })</summary>
				<div class="table-wrap">
					<table class="responsive">
						<thead>
							<tr><th>URI</th><th style="width:70px">Proto</th><th style="width:80px">Type</th><th style="width:110px">Probe</th></tr>
						</thead>
						<tbody>
							for _, c := range h.Candidates {
								<tr>
									<td data-label="URI" class="mono">{ c.URI }</td>
									<td data-label="Proto">{ c.Protocol }</td>
									<td data-label="Type">{ candidateType(c) }</td>
									<td data-label="Probe"><span class={ reachableClass(c.Reachable) }>{ reachableLabel(c.Reachable) }</span></td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</details>
		}
	</div>
}

templ settingsBanner(vm SettingsVM) {
	if vm.Err != "" {
		<div class="notice notice-err">{ vm.Err }</div>
	} else if vm.SavedNotLive {
		<div class="notice notice-warn">{ vm.Warn }. The saved settings will take effect on the next restart.</div>
	} else if vm.Saved {
		<div class="notice notice-ok">Saved and applied live.</div>
	}
}

// textField is one labelled text input with a muted help line.
templ textField(label, name, value, help string) {
	<label class="field">
		<span class="field-label">{ label }</span>
		<input type="text" name={ name } value={ value } placeholder={ help } autocomplete="off" spellcheck="false"/>
		if help != "" {
			<span class="small muted">{ help }</span>
		}
	</label>
}

// secretField renders a credential input: a tri-state badge (set / not set /
// unreadable), a write-only password box (blank = keep current), and — when a
// token is stored — a checkbox to clear it. The value is never rendered back.
// "unreadable" means a token IS stored but can't be decrypted with the current
// PLEXMIRROR_SECRET_KEY (rotated/misconfigured), so the operator isn't misled
// into thinking the credential is simply absent.
templ secretField(label, name string, isSet, unreadable bool, help string) {
	<label class="field">
		<span class="field-label">
			{ label }
			if unreadable {
				<span class="badge badge-error" title="A token is stored but can't be decrypted with the current PLEXMIRROR_SECRET_KEY. Re-enter it, or restore the original key.">unreadable</span>
			} else if isSet {
				<span class="badge badge-ready">set</span>
			} else {
				<span class="badge badge-muted">not set</span>
			}
		</span>
		<input type="password" name={ name } value="" placeholder={ secretPlaceholder(isSet) } autocomplete="new-password"/>
		if isSet || unreadable {
			<label class="clear-secret small muted">
				<input type="checkbox" name={ clearFieldName(name) } value="1"/>
				clear stored token
			</label>
		}
		if help != "" {
			<span class="small muted">{ help }</span>
		}
	</label>
}
